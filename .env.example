# MIND World — environment variables.
#
# VITE_MIND_API_BASE — base URL for the MIND backend.
#   Production:  https://www.m-i-n-d.ai
#   Local dev:   https://www.m-i-n-d.ai  (default — points at prod so dev sees real data)
VITE_MIND_API_BASE=https://www.m-i-n-d.ai

# VITE_POSTHOG_KEY — PostHog project public key. Optional; analytics are
# a no-op when unset. Pull from the Vercel dashboard or PostHog project
# 323965 (see MIND memory `reference_mindapp_posthog.md`).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
